# Copy to .env and fill in for your environment.
# Requires a reachable MySQL server (5.7+ / 8.x) — connected to via the
# PyMySQL driver, a pure-Python package already installed by `poetry install`.

ENVIRONMENT=development

# Comma-separated list is not supported here; edit settings.py's default or
# override via a JSON-style env value, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]

DB_SERVER=localhost
DB_PORT=3306
DB_NAME=voice_bot
DB_USER=root
DB_PASSWORD=change-me

# Which provider app.services.llm hands out — "anthropic" or "openai".
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Which providers app.services.voice hands out. Only one option each right
# now — the point is that adding another (e.g. a second STT provider)
# means adding a case in services/voice/factory.py, not touching callers.
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
REALTIME_VOICE_PROVIDER=openai_realtime

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Reuses OPENAI_API_KEY above — only the model differs for Realtime.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Mock roleplay WebSocket timing (app.api.websockets) — no voice/LLM
# provider involved yet, see that package's docstring.
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_MOCK_MESSAGE_INTERVAL_SECONDS=3.5
WS_MOCK_STREAM_CHUNK_DELAY_SECONDS=0.05
